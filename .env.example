# 服务器端口
PORT=3000

# 跨域白名单（可选）：默认不跨域（前后端同源部署）。
# 仅当前后端分离部署时才需要配置，多个来源用英文逗号分隔，例如：
# CORS_ORIGINS=https://frontend.example.com,https://admin.example.com
# CORS_ORIGINS=

# JWT 密钥（生产环境务必修改为复杂随机字符串）
JWT_SECRET=your-secret-key-please-change-in-production

# 初始管理员账户（首次启动时自动创建，密码至少 8 位）
# 若不设置 ADMIN_PASSWORD，将跳过管理员自动创建
ADMIN_EMAIL=admin@photoblog.com
ADMIN_PASSWORD=please-change-me

# 邮件发送（SMTP）。生产环境必填。
# 不填则进入开发模式：邮件会打到控制台并通过 devCode/devLink 字段回给调用方。
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=johnkaylou@hotmail.com
SMTP_PASS=zcmhpmmhohidgfha
SMTP_FROM=johnkaylou@hotmail.com

# 邮件重置链接、订阅通知等邮件中使用的站点基础 URL
PUBLIC_BASE_URL=http://localhost:3000

# 支付方式：mock（默认，开发/演示） / alipay / wechat / stripe
PAYMENT_METHOD=mock

# 支付宝（PAYMENT_METHOD=alipay 时必填）
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=
# ALIPAY_ALIPAY_PUBLIC_KEY=

# Stripe（PAYMENT_METHOD=stripe 时必填）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
# STRIPE_PRICE_LIFETIME=

# 数据库路径（默认即可）
DB_PATH=./db/photo_blog.db
